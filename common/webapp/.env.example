# BlueMap webapp build-time flags (Vite reads process.env at build).
# Copy to `.env` to override. All default to the performance-optimized value;
# documented here so any change is reversible.

# Emit production sourcemaps (adds a ~3.6 MB .js.map to dist). Default: off.
VITE_SOURCEMAP=false

# Precompress build assets to static .br/.gz siblings for nginx brotli_static/gzip_static.
# Values: both (default) | brotli | gzip | off
VITE_PRECOMPRESS=both
