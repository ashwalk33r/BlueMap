# Deployment configuration for `make deploy` / `make deploy-fspermissions`.
# Copy to .env and fill in real values. .env is gitignored.

# SSH host alias (from ~/.ssh/config) used by rsync to upload the webapp,
# connecting as the unprivileged deploy user.
DEPLOY_RSYNC_HOST=deployuser@example.com

# SSH host alias used to run privileged (sudo) permission fixes on the server.
DEPLOY_SSH_HOST=example-admin

# Absolute path to the web root on the server.
DEPLOY_ROOT=/var/www/example.com

# Unprivileged account that performs deploys (added to the shared group).
DEPLOY_USER=deployuser

# Shared group owning the web root (typically the web server's group).
DEPLOY_GROUP=www-data
